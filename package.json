{
  "name": "rangescout-eu",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "gds:validate-manifest": "gds-compliance validate-manifest --manifest ./gds-adoption.json",
    "gds:check": "gds-compliance check --manifest ./gds-adoption.json",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:restore-payloads": "npx tsx scripts/restore-from-payloads.ts",
    "imgbb:upload-assets": "node -r ./scripts/load-env.cjs scripts/imgbb-upload-assets.cjs",
    "vercel:env:push": "node -r ./scripts/load-env.cjs scripts/sync-vercel-env.cjs",
    "ingest:listing": "node -r ./scripts/load-env.cjs scripts/ingest-listing-automation.cjs",
    "curator:run": "npx tsx scripts/run-curator-once.ts",
    "audit:curated": "node scripts/audit-curated-payloads.cjs",
    "env:generate": "node scripts/generate-env-secrets.cjs",
    "env:generate:dry": "node scripts/generate-env-secrets.cjs --dry-run",
    "env:rotate-ingest-key": "node scripts/generate-env-secrets.cjs --ingest-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:mantine": "node scripts/check-mantine-consistency.cjs",
    "scarcity:report": "npx tsx scripts/report-scarcity.ts --write-dir docs/reports",
    "catalog:audit": "npx tsx scripts/review-live-catalog.ts --write-dir docs/reports",
    "catalog:image-backfill": "npx tsx scripts/backfill-image-fingerprints.ts --only-missing",
    "catalog:image-audit": "npx tsx scripts/audit-image-duplicates.ts --write-dir docs/reports",
    "catalog:image-remediate": "npx tsx scripts/remediate-historical-duplicate-images.ts",
    "curation:release-check": "node scripts/run-curation-release-check.cjs",
    "mommypoppins:capability-audit": "npx tsx scripts/report-mommypoppins-capabilities.ts --write-dir docs/reports",
    "mommypoppins:inventory": "npx tsx scripts/export-mommypoppins-inventory.ts --write-dir docs/reports",
    "mommypoppins:lead-export": "npx tsx scripts/export-mommypoppins-leads.ts --write-dir docs/reports",
    "checklist:mission": "npx tsx scripts/export-checklist-mission.ts --write-dir docs/reports",
    "checklist:sync": "node -r ./scripts/load-env.cjs --import tsx ./scripts/sync-checklist-mission.ts",
    "catalog:watchdog": "npx tsx scripts/report-catalog-watchdog.ts --write-dir docs/reports"
  },
  "dependencies": {
    "@doneisbetter/gds-admin": "https://github.com/sovereignsquad/general-design-system/releases/download/gds-v2.6.4/doneisbetter-gds-admin-2.6.4.tgz",
    "@doneisbetter/gds-core": "https://github.com/sovereignsquad/general-design-system/releases/download/gds-v2.6.4/doneisbetter-gds-core-2.6.4.tgz",
    "@doneisbetter/gds-theme": "https://github.com/sovereignsquad/general-design-system/releases/download/gds-v2.6.4/doneisbetter-gds-theme-2.6.4.tgz",
    "@mantine/core": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-query": "^5.83.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "mongodb": "^7.2.0",
    "next": "^15.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@doneisbetter/gds-compliance": "https://github.com/sovereignsquad/general-design-system/releases/download/gds-v2.6.4/doneisbetter-gds-compliance-2.6.4.tgz",
    "@doneisbetter/gds-eslint-config": "https://github.com/sovereignsquad/general-design-system/releases/download/gds-v2.6.4/doneisbetter-gds-eslint-config-2.6.4.tgz",
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.3.2",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
